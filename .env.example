# 複製成 .env.local 再填入真實值（.env.local 已列入 .gitignore，不會進 Git）
# 取得方式：Supabase 專案頁上方的「Connect」→ App Frameworks → React / Vite
# 或 Project Settings → API Keys

VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# 填 Publishable key（sb_publishable_ 開頭）。舊專案也可填 legacy anon key。
# 絕對不要填 Secret key（sb_secret_）或 service_role key。
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# ── 以下不要寫進 .env.local ──
# npm run test:rls 用的兩個測試帳號，放在另一個檔案 .env.test.local（同樣不會進 Git）：
# TEST_A_EMAIL=a@example.com
# TEST_A_PASSWORD=
# TEST_B_EMAIL=b@example.com
# TEST_B_PASSWORD=
